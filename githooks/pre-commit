#!/bin/sh
# BooMGateway pre-commit hook
# 快速检查代码格式，避免明显的格式问题推到远端
# 完整的 clippy/test 由 CI 负责

set -e

# 加载 cargo 环境（不同安装方式路径不同）
if [ -f "$HOME/.cargo/env" ]; then
    . "$HOME/.cargo/env"
elif [ -d "$HOME/.cargo/bin" ]; then
    export PATH="$HOME/.cargo/bin:$PATH"
fi

# 只检查有改动的 Rust 文件
RUST_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.rs$' || true)
if [ -z "$RUST_FILES" ]; then
    exit 0
fi

echo "→ Running cargo fmt --check on staged Rust files..."
if ! cargo fmt --all -- --check 2>&1; then
    echo ""
    echo "❌ 代码格式检查失败"
    echo "   请运行: cargo fmt --all"
    echo "   然后重新 git add 并提交"
    exit 1
fi

echo "✅ 格式检查通过"
